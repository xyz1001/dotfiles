{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": {
            "git push*": "ask",
            "rm *": "ask",
            "Remove-Item *": "ask",
            "del *": "ask",
            "*": "allow"
        },
        "*": "allow"
    },
    "provider": {
        "xyz1001": {
            "npm": "@ai-sdk/openai",
            "options": {
                "apiKey": "{env:XYZ1001_API_KEY}",
                "baseURL": "{env:XYZ1001_API_URL}"
            },
            "models": {
                "gpt-6-astra": {
                    "name": "GPT 6 Astra"
                },
                "gpt-6-astra-fast": {
                    "name": "GPT 6 Astra Fast"
                },
                "gpt-6-sol": {
                    "name": "GPT 6 Sol"
                },
                "gpt-6-sol-fast": {
                    "name": "GPT 6 Sol Fast"
                },
                "gpt-6-luna": {
                    "name": "GPT 6 Luna"
                },
                "gpt-6-luna-fast": {
                    "name": "GPT 6 Luna Fast"
                }
            }
        }
    },
    "mcp": {
        "sentry": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@sentry/mcp-server@latest",
                "--organization-slug={env:SENTRY_ORGANIZATION_SLUG}"
            ],
            "environment": {
                "SENTRY_ACCESS_TOKEN": "{env:SENTRY_ACCESS_TOKEN}",
                "SENTRY_HOST": "{env:SENTRY_HOST}"
            }
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app"
        },
        "mcp-atlassian": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-atlassian"
            ],
            "environment": {
                "JIRA_URL": "{env:JIRA_URL}",
                "JIRA_USERNAME": "{env:JIRA_USERNAME}",
                "JIRA_PERSONAL_TOKEN": "{env:JIRA_PERSONAL_TOKEN}",
                "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
                "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
                "CONFLUENCE_PERSONAL_TOKEN": "{env:CONFLUENCE_PERSONAL_TOKEN}"
            }
        },
        "jenkins": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-jenkins",
                "--jenkins-url={env:JENKINS_URL}",
                "--jenkins-username={env:JENKINS_USERNAME}",
                "--jenkins-password={env:JENKINS_PASSWORD}"
            ]
        },
        "servers": {
          "figma": {
            "type": "remote",
            "url": "https://mcp.figma.com/mcp"
          }
        }
    },
    "compaction": {
        "prune": true
    },
    "plugin": [
        "oh-my-opencode-slim"
    ],
    "agent": {
        "explore": {
            "disable": true
        },
        "general": {
            "disable": true
        }
    },
    "lsp": true
}
